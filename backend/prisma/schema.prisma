// WhatsApp Business AI Agent — data model (PostgreSQL / Supabase)
//
// MULTI-TENANT: every business is a `Tenant`. Every domain row carries a
// `tenantId` and is filtered by it in the app layer (see lib/tenantScope.js and
// middleware/tenant.js). WhatsApp credentials, branding and plan/limits live on
// the Tenant, so one deployment serves many businesses; inbound webhooks are
// routed to the right tenant by the Meta phone_number_id.
//
// NOTE: status/sender/question-type are kept as String (validated in app code)
// rather than Postgres enums, to keep the values flexible. tags / triggerWords /
// options / metadata / rawPayload are native jsonb (Prisma `Json`).
// The matching SQL lives in backend/supabase/schema.sql.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Tenant (one business / customer of the platform)
// ─────────────────────────────────────────────────────────────
model Tenant {
  id     String @id @default(cuid())
  name   String
  slug   String @unique // URL-safe id: used for the public /l/:slug bio page
  status String @default("active") // active | suspended | trial

  // ── WhatsApp Cloud API credentials (per tenant) ──
  // waPhoneNumberId is how inbound webhooks are routed to this tenant. The token
  // is stored encrypted (AES-256-GCM, see lib/crypto.js) — never in plaintext.
  waPhoneNumberId     String? @unique
  waBusinessAccountId String?
  waTokenEnc          String? // encrypted access token
  waVerifyToken       String? // webhook GET-handshake token (per Meta app)
  waApiVersion        String  @default("v21.0")
  // Meta 2-step-verification PIN set at /register. NOT a secret credential (unlike
  // waTokenEnc) — kept plaintext, consistent with waBusinessAccountId. MUST be
  // reused on every re-registration for an already-registered number, or Meta
  // rejects the call — so once set it is never regenerated. See services/whatsapp.js.
  waPin               String?

  // ── Branding / localization ──
  displayName String?
  bioTitle    String?
  bioSubtitle String?
  locale      String  @default("he")
  currency    String  @default("ILS")
  timezone    String  @default("Asia/Jerusalem")

  // ── Legal (per-tenant privacy/terms identity) ──
  legalCompanyName  String?
  legalContactEmail String?
  legalWebsiteUrl   String?

  // ── Billing / plan ──
  plan                String    @default("trial") // trial | starter | pro | heyil
  dailyBroadcastCap   Int       @default(250) // rolling-24h business-initiated cap
  monthlyMessageLimit Int       @default(1000) // soft cap on agent messages/period
  messagesThisPeriod  Int       @default(0)
  periodStartedAt     DateTime  @default(now())
  trialEndsAt         DateTime?

  // ── Stripe Billing subscription (recurring HeyIL plan, ₪490/mo) ──
  // Set by the checkout.session.completed webhook when a subscription Checkout
  // Session completes (services/payments.js, routes/payments.js); kept in sync by
  // invoice.paid on each renewal. Nullable — a tenant with no subscription (manual
  // plan assignment, or the one-time credit-pack flow) leaves these unset.
  stripeCustomerId     String? // Stripe Customer id (cus_...)
  stripeSubscriptionId String? // Stripe Subscription id (sub_...)
  subscriptionStatus   String? // active | past_due | canceled | incomplete (Stripe's own values)

  // ── AI credits (1 credit = 1 AI-answered message) ──
  // Monthly allotment = monthlyMessageLimit, consumed via creditsUsedThisPeriod
  // (resets each period). purchasedCredits is a non-resetting top-up balance,
  // consumed only after the monthly allotment is exhausted. See CREDITS_DESIGN.md.
  creditsUsedThisPeriod Int       @default(0)
  purchasedCredits      Int       @default(0)
  lowCreditNotifiedAt   DateTime? // throttles the "out of credits" nudge

  // ── Google integration (Gmail + Calendar) — paid add-on, OFF by default ──
  // Per-tenant feature flag. When false (the default), the Connect flow and every
  // Calendar/Gmail action return "not enabled"; nothing is exposed. Turned on
  // per-tenant only when a customer buys the add-on (super-admin sets the flag).
  // googleTokensEnc holds the OAuth token set (access + refresh) encrypted at rest
  // with the same AES-256-GCM helper as waTokenEnc (lib/crypto.js) — never plaintext,
  // never sent to the client. googleConnectedEmail is the connected account, shown
  // read-only in the dashboard. See services/googleIntegration.js.
  //
  // MIGRATION NOTE (AP-T58/AP-T71): additive & nullable — safe to add to schema
  // ahead of the live apply. Until migration 5_google_integration is applied to the
  // live DB, code MUST NOT implicitly SELECT * on Tenant (would P2022); all reads
  // here use explicit `select`.
  googleIntegrationEnabled Boolean @default(false)
  googleTokensEnc          String? // encrypted OAuth token set (access + refresh)
  googleConnectedEmail     String? // the connected Google account email

  // ── Owner-toggled integrations (Gmail, Calendar, Sheets, Webhook/CRM, …) ──
  // Map of { [slug]: boolean } persisted as JSONB. The owner flips these in
  // Settings → אינטגרציות. Enabling any Google-group item also drives
  // googleIntegrationEnabled (the gate the Google service actually reads).
  // Nullable/additive (MIGRATION 10_tenant_integrations) — code treats null as {}.
  integrations Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admins            AdminUser[]
  customers         Customer[]
  conversations     Conversation[]
  messages          Message[]
  flows             Flow[]
  questions         FlowQuestion[]
  answers           CustomerAnswer[]
  links             Link[]
  events            AnalyticsEvent[]
  knowledgeBase     KnowledgeBase?
  suppressed        SuppressedNumber[]
  broadcasts        BroadcastJob[]
  outboundSends     OutboundSend[]
  creditTxns        CreditTransaction[]
  creditPurchases   CreditPurchase[]
  googleOAuthStates GoogleOAuthState[]
  metaCostEntries   MetaCostEntry[]

  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// Credit pack purchase (top-up). Created 'pending' when a tenant picks a pack;
// flipped to 'paid' by the payment webhook (real gateway) or a super-admin (manual),
// which grants the credits. See CREDITS_DESIGN.md.
// ─────────────────────────────────────────────────────────────
model CreditPurchase {
  id          String    @id @default(cuid())
  tenantId    String
  packId      String // e.g. pack_5000
  credits     Int
  amountIls   Int // price in whole shekels
  status      String    @default("pending") // pending | paid | cancelled
  provider    String    @default("manual") // manual | stripe | payplus | meshulam | cardcom
  providerRef String? // gateway transaction id (Stripe Checkout Session id, PayPlus page_request_uid, ...)
  createdAt   DateTime  @default(now())
  paidAt      DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([status, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Credit ledger — every debit (AI reply) and credit (top-up / grant).
// The single source of truth for "how much a tenant spent". See CREDITS_DESIGN.md.
// ─────────────────────────────────────────────────────────────
model CreditTransaction {
  id        String   @id @default(cuid())
  tenantId  String
  type      String // debit | topup | grant | adjust
  amount    Int // signed: -1 for an AI message, +N for a top-up/grant
  reason    String? // ai_reply | pack_1000 | manual_grant | ...
  messageId String? // the agent Message this debit paid for (audit trail)
  tokensIn  Int? // OpenAI prompt tokens (internal cost tracking)
  tokensOut Int? // OpenAI completion tokens
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Meta (WhatsApp) conversation-cost ledger — one row per billable Meta
// conversation event (from the webhook's `statuses[]` pricing object). This is
// the COST side of the margin equation, parallel to CreditTransaction (revenue).
// See system-gap-analysis §2.7 + §4 and services/metaCost.js.
//
// Meta bills WhatsApp Business conversations by PRICING CATEGORY. Each status
// event that carries a `pricing` object (billable=true) is one row here. Cost is
// ESTIMATED from a config rate card (config.metaPricing) — placeholder/0 until the
// owner fills real Meta rate-card numbers, so costEstimateCents is never fabricated.
//
// ADDITIVE / DRIFT-SAFE (AP-T58/AP-T71): a NEW table, no changes to existing
// models, so adding it to schema ahead of live-apply does NOT break existing
// implicit-select queries on other models. The recorder (services/metaCost.js)
// wraps its insert in a try/catch that degrades to a no-op if the table is not yet
// migrated live, so Meta-cost recording can never break the inbound message flow.
// ─────────────────────────────────────────────────────────────
model MetaCostEntry {
  id       String @id @default(cuid())
  tenantId String

  // Our Conversation.id when we can map the Meta conversation to one of ours;
  // otherwise null (status events reference Meta's own conversation id, which we
  // don't always have a local mapping for). metaConversationId is Meta's id from
  // the pricing/conversation object — kept for reconciliation with Meta analytics.
  conversationId    String?
  metaConversationId String?
  waMessageId       String? // the Meta message id the status is about (audit trail)

  // Meta's pricing classification. `category` is normalized to the current Meta
  // set (marketing | utility | authentication | service). `rawCategory` keeps
  // exactly what the webhook sent (business_initiated | user_initiated |
  // referral_conversion | marketing | ...) for auditing a pricing-model change.
  category    String
  rawCategory String?
  pricingModel String? // Meta's pricing_model (e.g. CBP / PMP) when present
  billable    Boolean @default(true)

  // Estimated Meta cost for this conversation, in whole CENTS of `currency`,
  // derived from config.metaPricing.ratesCents[category]. `placeholder`=true means
  // the rate card was uncalibrated (0/placeholder) when this was recorded — the
  // margin view must NOT treat it as a real Meta cost.
  costEstimateCents Int     @default(0)
  currency          String  @default("USD")
  placeholder       Boolean @default(true)

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Idempotency guard (mirrors Message.@@unique([tenantId, waMessageId])). Meta
  // delivers status webhooks AT-LEAST-ONCE, so a redelivered payload carries the
  // SAME waMessageId + SAME category — without this, each redelivery would insert a
  // duplicate cost row and silently overstate Meta cost in GET /api/admin/margin.
  // Keyed on category too (not just waMessageId) so a genuinely DIFFERENT billable
  // category for the same message id can still create a distinct row — we only block
  // an exact (tenant, message, category) repeat. waMessageId is nullable; Postgres
  // treats NULLs as distinct, so rows with no message id are never deduped (correct —
  // there is nothing to dedupe on). recordMetaCostEvents() catches the resulting
  // P2002 unique-violation as a no-op skip so the webhook path never throws.
  @@unique([tenantId, waMessageId, category])
  @@index([tenantId, createdAt])
  @@index([tenantId, category])
}

// ─────────────────────────────────────────────────────────────
// Google OAuth state nonce (CSRF / tenant-binding for the OAuth handshake)
// ─────────────────────────────────────────────────────────────
// One short-lived, single-use row per initiated Connect. /connect creates a row
// binding a random `state` value to the initiating tenantId (server-side); the
// public /callback resolves the incoming ?state= back to that tenantId by looking
// it up here — so the tenant identity is SERVER-VALIDATED, never trusted from the
// attacker-observable OAuth state param. The row is DELETED on first use
// (single-use → replay-proof) and ignored past `expiresAt` (short TTL). This is
// what lets /callback be a public route (no requireAuth) while still binding the
// callback to exactly the tenant that started the flow. Part of the same unapplied
// 5_google_integration migration (add-on-gated; see services/googleIntegration.js).
model GoogleOAuthState {
  state     String   @id // random 32-byte hex nonce (the OAuth `state`)
  tenantId  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────────────────────
// A super_admin (platform owner) has role='super_admin' and tenantId=null and
// can manage all tenants. A tenant admin/agent has a tenantId and is scoped to
// it. Email is globally unique (it's the login key).
model AdminUser {
  id                String   @id @default(cuid())
  tenantId          String?
  email             String   @unique
  name              String
  passwordHash      String
  role              String   @default("admin") // super_admin | admin | agent
  mustResetPassword Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// Core domain
// ─────────────────────────────────────────────────────────────
model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String?
  phone     String
  email     String?
  tags      Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  answers       CustomerAnswer[]
  events        AnalyticsEvent[]

  // Same phone can belong to different tenants; unique only within a tenant.
  @@unique([tenantId, phone])
  @@index([tenantId])
}

model Conversation {
  id                String   @id @default(cuid())
  tenantId          String
  customerId        String
  whatsappPhone     String
  status            String   @default("active") // active | completed | abandoned | needs_human
  intent            String?
  currentFlowId     String?
  currentQuestionId String?
  needsHuman        Boolean  @default(false)
  lastMessage       String?
  leadScore         Int      @default(0)
  linkSent          Boolean  @default(false)
  assignedTo        String?
  tags              Json     @default("[]")
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastActivityAt    DateTime @default(now())

  // ── AI-credit 24h window ──
  // Billing unit for AI credits is a rolling 24-hour CONVERSATION window (1 credit =
  // one handled conversation within 24h, NOT per AI message). windowStartedAt/
  // windowExpiresAt mark the currently-open window; a credit is charged only when an
  // AI reply OPENS a new window (windowExpiresAt null or in the past). See
  // lib/credits.js chargeAiCredit() and CREDITS_DESIGN.md.
  windowStartedAt DateTime?
  windowExpiresAt DateTime?

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  flow     Flow?            @relation(fields: [currentFlowId], references: [id])
  messages Message[]
  answers  CustomerAnswer[]
  events   AnalyticsEvent[]

  @@index([tenantId, status])
  @@index([tenantId, lastActivityAt])
  @@index([customerId])
}

model Message {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String
  senderType     String // customer | agent | human
  messageText    String
  intent         String?
  waMessageId    String? // Meta's message id — for inbound idempotency
  // Delivery state for OUTBOUND messages, advanced by Meta's status webhooks
  // (sent → delivered → read; or failed). Null for inbound/customer messages and
  // until the first receipt arrives. Additive/nullable — MIGRATION 11_message_status.
  status         String?
  rawPayload     Json?
  createdAt      DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, waMessageId])
  @@index([conversationId])
  @@index([tenantId, createdAt])
}

model Flow {
  id               String   @id @default(cuid())
  tenantId         String
  name             String
  description      String?
  triggerWords     Json     @default("[]")
  finalMessage     String?
  sendFinalMessage Boolean  @default(true) // when false, no closing message is sent at flow end
  linkId           String?
  isActive         Boolean  @default(true)
  isDefault        Boolean  @default(false) // start on ANY message (no trigger words needed)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  questions     FlowQuestion[]
  link          Link?            @relation("FlowLink", fields: [linkId], references: [id])
  conversations Conversation[]
  answers       CustomerAnswer[]
  events        AnalyticsEvent[]
  relatedLinks  Link[]           @relation("LinkRelatedFlow")

  @@index([tenantId])
}

model FlowQuestion {
  id           String   @id @default(cuid())
  tenantId     String
  flowId       String
  questionText String
  questionType String   @default("text") // text|phone|email|number|single_choice|multiple_choice|yes_no|date|custom
  options      Json     @default("[]")
  voiceUrl     String? // optional pre-recorded voice note (audio) sent when this question is asked
  imageUrl     String? // optional image sent when this question is asked
  isRequired   Boolean  @default(true)
  orderIndex   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flow    Flow             @relation(fields: [flowId], references: [id], onDelete: Cascade)
  answers CustomerAnswer[]

  @@index([flowId])
  @@index([tenantId])
}

model CustomerAnswer {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String
  customerId     String
  flowId         String?
  questionId     String?
  questionText   String?
  answer         String
  createdAt      DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  flow         Flow?         @relation(fields: [flowId], references: [id])
  question     FlowQuestion? @relation(fields: [questionId], references: [id])

  @@index([conversationId])
  @@index([tenantId])
}

model Link {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  url           String
  description   String?
  relatedFlowId String?
  isActive      Boolean  @default(true)
  trackClicks   Boolean  @default(true)
  showOnBio     Boolean  @default(false) // show on the public /l link page
  clicksCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  relatedFlow Flow?  @relation("LinkRelatedFlow", fields: [relatedFlowId], references: [id])
  flowsUsing  Flow[] @relation("FlowLink")

  @@index([tenantId])
}

model AnalyticsEvent {
  id             String   @id @default(cuid())
  tenantId       String
  eventName      String
  conversationId String?
  customerId     String?
  customerPhone  String?
  flowId         String?
  questionId     String?
  metadata       Json?
  createdAt      DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  flow         Flow?         @relation(fields: [flowId], references: [id], onDelete: SetNull)

  @@index([tenantId, eventName])
  @@index([tenantId, eventName, flowId])
  @@index([tenantId, eventName, questionId])
  @@index([tenantId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Broadcast guardrails
// ─────────────────────────────────────────────────────────────

// Numbers that must never receive broadcasts: opted out via keyword ("הסר"),
// or manually suppressed. Phone is normalized (972…). Scoped per tenant.
model SuppressedNumber {
  id        String   @id @default(cuid())
  tenantId  String
  phone     String
  reason    String   @default("opt_out") // opt_out | manual
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, phone])
  @@index([tenantId])
}

// A broadcast campaign processed in the background. `cursor` points at the next
// contact to process, so a job stopped by the daily cap / circuit breaker /
// server restart resumes exactly where it left off.
model BroadcastJob {
  id                 String   @id @default(cuid())
  tenantId           String
  status             String   @default("running") // running | completed | stopped | quota_reached | aborted
  abortReason        String?
  mode               String   @default("template") // template | text
  templateName       String?
  languageCode       String?
  message            String?
  headerImageLink    String?
  headerImageId      String?
  requireHeaderImage Boolean  @default(false)
  throttleMs         Int      @default(300)
  contacts           Json // deduped [{ phone, vars, ... }] — the full work list
  cursor             Int      @default(0)
  total              Int
  sent               Int      @default(0)
  failedCount        Int      @default(0)
  invalidCount       Int      @default(0)
  suppressedCount    Int      @default(0)
  duplicatesRemoved  Int      @default(0)
  failures           Json     @default("[]") // capped sample of { phone, error }
  invalid            Json     @default("[]") // capped sample of { phone, error }
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

// Ledger of business-initiated sends — one row per delivered API call. Powers
// the rolling-24h cap that keeps each tenant under Meta's messaging-tier limit.
model OutboundSend {
  id        String   @id @default(cuid())
  tenantId  String
  phone     String
  jobId     String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([jobId])
}

// Knowledge base — one record per tenant (the agent answers from it).
model KnowledgeBase {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  businessDescription String?
  productInfo         String?
  serviceInfo         String?
  prices              String?
  shippingInfo        String?
  returnPolicy        String?
  faq                 String?
  openingHours        String?
  contactDetails      String?
  limitations         String?
  customInstructions  String?
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
