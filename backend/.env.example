# ── Server ────────────────────────────────────────────────
PORT=4010
NODE_ENV=development
# Public base URL of this backend (used to build trackable short links)
PUBLIC_BASE_URL=http://localhost:4010
# Comma separated list of allowed admin-app origins
CORS_ORIGIN=http://localhost:5173

# ── Database (PostgreSQL / Supabase) ──
# Supabase → Project Settings → Database → Connection string → URI.
# Use the "Connection pooling" (pgBouncer, port 6543) URI for the app and add
# ?pgbouncer=true&connection_limit=1 so Prisma plays nice with the pooler.
# Run schema migrations against the direct connection (port 5432) instead.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# ── Supabase Storage (for question voice notes) ──
# When both are set, uploaded audio is stored in a public Supabase bucket
# (survives Render redeploys). If left empty, uploads fall back to local disk.
# SUPABASE_URL → Project Settings → API → Project URL.
# SUPABASE_SERVICE_ROLE_KEY → Project Settings → API → service_role secret (server-only!).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=voice-notes

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Multi-tenant secrets ──────────────────────────────────
# AES-256-GCM key (32 bytes hex) encrypting each tenant's WhatsApp token at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENC_KEY=
# Platform super-admin bootstrap (used by `npm run db:seed`).
SUPERADMIN_EMAIL=owner@example.com
SUPERADMIN_PASSWORD=

# ── Broadcast caps (per-tenant defaults; overridable per tenant/plan) ──
BROADCAST_DEFAULT_DAILY_CAP=250
# Optional deployment-wide hard ceiling clamping every tenant (0 = off).
BROADCAST_PLATFORM_MAX=0

# ── OpenAI (leave empty to use the built-in rule-based fallback) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Legal pages (served at /privacy and /terms — used for the Meta app token) ──
LEGAL_APP_NAME=WhatsApp Business AI Agent
LEGAL_COMPANY_NAME=Your Company
LEGAL_CONTACT_EMAIL=support@example.com
LEGAL_WEBSITE_URL=
LEGAL_EFFECTIVE_DATE=2026-06-09

# ── WhatsApp Cloud API (master/fallback account; leave empty for the simulator) ──
# In multi-tenant operation each tenant stores its own credentials in the DB;
# these env creds are the master fallback and seed the default tenant on migration.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account (WABA) ID — needed to list message templates for the
# broadcast feature. Find it in App Dashboard → WhatsApp → API Setup.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=my-verify-token
# Meta app secret — verifies inbound webhook HMAC signatures (X-Hub-Signature-256).
# Leave empty ONLY in local dev; set it in production.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# ── Meta Embedded Signup (onboard a customer's WABA in a few clicks) ──
# From your Meta app: App ID and the Embedded Signup "configuration id".
# META_APP_SECRET falls back to WHATSAPP_APP_SECRET if unset.
META_APP_ID=
META_CONFIG_ID=
# META_APP_SECRET=
# META_GRAPH_VERSION=v21.0

# ── Platform-hosted numbers ("connect by number + code", no popup) ──
# Register a customer's number under OUR own WABA via the Cloud API: they type the
# number + the code Meta texts them. Requires an approved Tech Provider app.
#   PLATFORM_WABA_ID  → your platform WhatsApp Business Account ID
#                       (App Dashboard → WhatsApp → API Setup). Falls back to
#                       WHATSAPP_BUSINESS_ACCOUNT_ID.
#   PLATFORM_WA_TOKEN → a PERMANENT system-user token with whatsapp_business_management
#                       + whatsapp_business_messaging. Falls back to WHATSAPP_TOKEN.
#   PLATFORM_WA_PIN   → any 6-digit PIN (the 2-step PIN set on each registered number).
# The connect-by-number UI stays hidden until PLATFORM_WABA_ID + PLATFORM_WA_TOKEN are set.
PLATFORM_WABA_ID=
PLATFORM_WA_TOKEN=
PLATFORM_WA_PIN=

# ── Observability ─────────────────────────────────────────
# Sentry DSN for error tracking (leave empty to disable).
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# ── Usage window ──────────────────────────────────────────
# Days before a tenant's messagesThisPeriod counter resets (default 30).
USAGE_PERIOD_DAYS=30
# Delay (ms) before sending a question's voice note when it also has an image,
# so the image (fetched by URL) arrives first. Default 1000. Lower = shorter wait.
MEDIA_SEND_DELAY_MS=1000
