# Your Anthropic API key (console.anthropic.com) — used to generate replies.
ANTHROPIC_API_KEY=sk-ant-...

# The shared secret you set in HeyIL → Settings → מוח תגובות מותאם → "סוד לחתימה".
# Used to verify each reply.request really came from HeyIL (HMAC).
HEYIL_SECRET=

# For the Ops agent (ops-agent.mjs): a HeyIL API key (Settings → מפתחות API) and your
# HeyIL base URL.
HEYIL_API_KEY=heyil_sk_...
HEYIL_BASE_URL=https://heyil.co.il

# Local port for the reply server.
PORT=8787
